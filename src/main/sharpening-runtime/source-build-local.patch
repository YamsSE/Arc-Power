diff --git a/source/managed_sharpening_control.hpp b/source/managed_sharpening_control.hpp
new file mode 100644
index 0000000..89efcd8
--- /dev/null
+++ b/source/managed_sharpening_control.hpp
@@ -0,0 +1,114 @@
+#pragma once
+// Private Arc Power controlled-runtime prototype. Not production code.
+#include <windows.h>
+#include <sddl.h>
+#include <atomic>
+#include <cstdint>
+#include <thread>
+#include <string>
+#include <vector>
+
+namespace reshade::managed_sharpening
+{
+#pragma pack(push, 1)
+struct request { uint32_t magic; uint16_t version; uint16_t size; uint32_t operation; uint32_t revision; uint32_t percent; uint32_t enabled; };
+struct reply { uint32_t magic; uint16_t version; uint16_t size; uint32_t status; uint32_t accepted_revision; uint32_t applied_revision; };
+struct acknowledgment { uint32_t magic; uint16_t version; uint16_t size; uint32_t revision; };
+#pragma pack(pop)
+static constexpr uint32_t kMagic = 0x43505341; // ASPC
+static std::atomic<uint64_t> desired { 0 }; // revision[31:0], enabled[32], percent[39:33]
+static std::atomic<uint32_t> applied { 0 };
+static std::atomic<bool> started { false };
+static std::wstring pipe_name;
+
+inline uint64_t snapshot() { return desired.load(std::memory_order_acquire); }
+inline uint32_t revision(uint64_t value) { return static_cast<uint32_t>(value); }
+inline uint32_t percent(uint64_t value) { return static_cast<uint32_t>((value >> 33) & 0x7f); }
+inline bool enabled(uint64_t value) { return ((value >> 32) & 1) != 0; }
+inline uint32_t applied_revision() { return applied.load(std::memory_order_acquire); }
+
+inline bool bounded_read(HANDLE pipe, void *buffer, DWORD length)
+{
+    auto *bytes = static_cast<uint8_t *>(buffer); DWORD total = 0; const ULONGLONG deadline = GetTickCount64() + 2000;
+    while (total < length && GetTickCount64() < deadline) {
+        DWORD got = 0;
+        if (ReadFile(pipe, bytes + total, length - total, &got, nullptr)) { total += got; continue; }
+        const DWORD e = GetLastError(); if (e != ERROR_NO_DATA && e != ERROR_PIPE_LISTENING) return false;
+        Sleep(5);
+    }
+    return total == length;
+}
+inline bool bounded_write(HANDLE pipe, const void *buffer, DWORD length)
+{
+    const auto *bytes = static_cast<const uint8_t *>(buffer); DWORD total = 0; const ULONGLONG deadline = GetTickCount64() + 2000;
+    while (total < length && GetTickCount64() < deadline) {
+        DWORD wrote = 0;
+        if (WriteFile(pipe, bytes + total, length - total, &wrote, nullptr)) { total += wrote; continue; }
+        const DWORD e = GetLastError(); if (e != ERROR_NO_DATA && e != ERROR_PIPE_LISTENING) return false;
+        Sleep(5);
+    }
+    return total == length;
+}
+inline void listener()
+{
+    HANDLE token = nullptr; if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) return;
+    DWORD bytes = 0; GetTokenInformation(token, TokenUser, nullptr, 0, &bytes);
+    std::vector<uint8_t> token_user(bytes);
+    if (!bytes || !GetTokenInformation(token, TokenUser, token_user.data(), bytes, &bytes)) { CloseHandle(token); return; }
+    LPWSTR sid = nullptr;
+    if (!ConvertSidToStringSidW(reinterpret_cast<TOKEN_USER *>(token_user.data())->User.Sid, &sid)) { CloseHandle(token); return; }
+    std::wstring sddl = L"D:P(A;;GA;;;" + std::wstring(sid) + L")(A;;GA;;;SY)";
+    LocalFree(sid); CloseHandle(token);
+    PSECURITY_DESCRIPTOR descriptor = nullptr;
+    if (!ConvertStringSecurityDescriptorToSecurityDescriptorW(sddl.c_str(), SDDL_REVISION_1, &descriptor, nullptr)) return;
+    SECURITY_ATTRIBUTES sa { sizeof(sa), descriptor, FALSE };
+    DWORD own_session = 0; ProcessIdToSessionId(GetCurrentProcessId(), &own_session);
+    for (;;) {
+        HANDLE pipe = CreateNamedPipeW(pipe_name.c_str(), PIPE_ACCESS_DUPLEX,
+            PIPE_TYPE_MESSAGE | PIPE_READMODE_MESSAGE | PIPE_NOWAIT | PIPE_REJECT_REMOTE_CLIENTS,
+            1, sizeof(reply), sizeof(request), 0, &sa);
+        if (pipe == INVALID_HANDLE_VALUE) { Sleep(1000); continue; }
+        const ULONGLONG connect_deadline = GetTickCount64() + 2000;
+        bool connected = false;
+        while (GetTickCount64() < connect_deadline) {
+            if (ConnectNamedPipe(pipe, nullptr)) { connected = true; break; }
+            const DWORD e = GetLastError(); if (e == ERROR_PIPE_CONNECTED) { connected = true; break; }
+            if (e != ERROR_PIPE_LISTENING && e != ERROR_NO_DATA) break;
+            Sleep(5);
+        }
+        if (connected) {
+            DWORD client_pid = 0, client_session = 0; request in {};
+            const bool valid_client = GetNamedPipeClientProcessId(pipe, &client_pid) && client_pid &&
+                ProcessIdToSessionId(client_pid, &client_session) && client_session == own_session;
+            if (valid_client && bounded_read(pipe, &in, sizeof(in)) && in.magic == kMagic && in.version == 1 && in.size == sizeof(request)) {
+                uint64_t current = snapshot();
+                reply out { kMagic, 1, sizeof(reply), 1, revision(current), applied_revision() };
+                if (in.operation == 1 && in.percent <= 100 && in.enabled <= 1 && in.revision > revision(current)) {
+                    const uint64_t next = static_cast<uint64_t>(in.revision) |
+                        (static_cast<uint64_t>(in.enabled) << 32) | (static_cast<uint64_t>(in.percent) << 33);
+                    desired.store(next, std::memory_order_release);
+                    out.status = 0; out.accepted_revision = in.revision;
+                } else if (in.operation == 2) out.status = 0;
+                else out.status = 2;
+                out.applied_revision = applied_revision();
+                if (bounded_write(pipe, &out, sizeof(out))) {
+                    acknowledgment ack{};
+                    const bool received_ack = bounded_read(pipe, &ack, sizeof(ack)) && ack.magic == kMagic &&
+                        ack.version == 1 && ack.size == sizeof(ack) && ack.revision == out.accepted_revision;
+                    (void)received_ack;
+                }
+            }
+            DisconnectNamedPipe(pipe);
+        }
+        CloseHandle(pipe);
+    }
+}
+inline void start()
+{
+    bool expected = false; if (!started.compare_exchange_strong(expected, true)) return;
+    pipe_name = L"\\\\.\\pipe\\ArcPower.ManagedSharpening.v1." + std::to_wstring(GetCurrentProcessId());
+    std::thread(listener).detach();
+}
+}
+
